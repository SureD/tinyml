{
  "model_type": "embedding_gemma2",
  "dtype": "bfloat16",
  "text_config": {
    "model_type": "embedding_gemma2_text",
    "dtype": "bfloat16",
    "vocab_size": 20,
    "hidden_size": 8,
    "intermediate_size": 16,
    "num_hidden_layers": 2,
    "num_attention_heads": 2,
    "num_key_value_heads": 2,
    "head_dim": 4,
    "hidden_activation": "gelu_pytorch_tanh",
    "max_position_embeddings": 64,
    "rms_norm_eps": 1e-06,
    "attention_bias": false,
    "sliding_window": 2,
    "layer_types": [
      "sliding_attention",
      "full_attention"
    ],
    "hidden_size_per_layer_input": 4,
    "embedding_dim": 6,
    "rope_parameters": {
      "sliding_attention": {
        "rope_type": "default",
        "rope_theta": 10000.0
      },
      "full_attention": {
        "rope_type": "default",
        "rope_theta": 1000000.0
      }
    },
    "per_layer_config": {
      "1": {
        "head_dim": 8,
        "num_key_value_heads": 1
      }
    }
  }
}
